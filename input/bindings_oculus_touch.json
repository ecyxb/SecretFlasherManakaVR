{
  "action_manifest_version": 0,
  "alias_info": {},
  "controller_type": "oculus_touch",
  "category": "steamvr_input",
  "description": "",
  "name": "SecretFlasherManakaVR Quest 3",
  "options": {},
  "simulated_actions": [],
  "bindings": {
    "/actions/quest3": {
      "chords": [],
      "haptics": [],
      "poses": [
        {
          "output": "/actions/quest3/in/left_pose",

        },
        {
          "output": "/actions/quest3/in/right_pose",
          "path": "/user/hand/right/pose/tip"
        }
      ],
      "sources": [
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/quest3/in/a" } }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/quest3/in/b" } }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/quest3/in/x" } }
        },
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/quest3/in/y" } }
        },
        {
          "path": "/user/hand/left/input/application_menu",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/quest3/in/left_menu" } }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": { "grab": { "output": "/actions/quest3/in/left_grip" } }

          "mode": "joystick",
          "inputs": {
            "position": { "output": "/actions/quest3/in/left_stick" },
            "click": { "output": "/actions/quest3/in/l3" }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
